<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Puppy Crawl//DTD Check Configuration 1.3//EN"
        "http://www.puppycrawl.com/dtds/configuration_1_3.dtd">
<module name="Checker">

    <!-- Enforce no tabs, only spaces for indent. -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
        <property name="severity" value="error"/>
    </module>

    <!-- Enforce Unix newlines. -->
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf_cr_crlf"/>
        <property name="severity" value="error"/>
    </module>

    <!-- Check each Java file for violations. -->
    <module name="TreeWalker">

        <!-- Checks for Naming Conventions. -->
        <!-- See https://checkstyle.org/checks/naming/index.html -->
        <!-- Constants (public static finals) must be uppercase letters/digits/underscore. -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9_]*$"/>
            <!-- <property name="scope" value="public"/> -->
            <property name="severity" value="error"/>
        </module>

        <!-- Local variable name check. -->
        <module name="LocalFinalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <property name="severity" value="error"/>
        </module>

        <!-- Local variable name check. -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <property name="severity" value="error"/>
        </module>

        <!-- Member name check. -->
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <property name="severity" value="error"/>
        </module>

        <!-- Method name check. -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <property name="severity" value="error"/>
        </module>

        <!-- Package name check. -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
            <property name="severity" value="error"/>
        </module>

        <!-- <module name="ParameterName"/> -->
        <module name="StaticVariableName">
            <property name="format" value="^[A-Z][A-Z0-9_]*$"/>
            <property name="severity" value="error"/>
        </module>

        <!-- Class name check. -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
            <property name="severity" value="error"/>
        </module>

        <!-- Avoid star imports - enforce explicit imports -->
        <module name="AvoidStarImport">
            <property name="severity" value="error"/>
        </module>        

        <!-- Duplicate import checking. -->
        <module name="RedundantImport">
            <property name="severity" value="error"/>
        </module>

        <!-- Detects illegal type usage in declarations, parameters, and return types -->
        <module name="IllegalType">
            <property name="severity" value="error"/>
            </module>

        <!-- Detect raw types - generics used without type parameters -->
        <!-- Pattern 1: Comprehensive list of known generic types (standard library + common patterns) -->
        <!-- This can be easily extended by adding more types to the list -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="AvoidRawTypesKnown"/>
            <property name="format" value="(?&lt;!import\s)(?&lt;!import static\s)(?&lt;!&lt;)\b(List|Set|Map|Filter|Collection|Iterator|Comparable|Comparator|Iterable|Queue|Deque|Vector|Stack|Hashtable|Enumeration|Optional|Stream|Supplier|Consumer|Function|Predicate|BiFunction|BiConsumer|BiPredicate|UnaryOperator|BinaryOperator|Callable|Future|CompletableFuture|Executor|ExecutorService|ScheduledExecutorService)(?!\s*&lt;\?&gt;)\s+[a-z][a-zA-Z0-9]*(?=\s*[;=,)\]]|$)"/>
            <property name="format" value="(?&lt;!import\s)(?&lt;!import static\s)(?&lt;!&lt;)\b(List|Set|Map|Filter|Collection|Iterator|Comparable|Comparator|Iterable|Queue|Deque|Vector|Stack|Hashtable|Enumeration|Optional|Stream|Supplier|Consumer|Function|Predicate|BiFunction|BiConsumer|BiPredicate|UnaryOperator|BinaryOperator|Callable|Future|CompletableFuture|Executor|ExecutorService|ScheduledExecutorService)\s+[a-z][a-zA-Z0-9]*(?=\s*[;=,)\]]|$)"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Avoid using raw types. Generic types must include type parameters (e.g., List&lt;String&gt; instead of List)."/>
            <property name="severity" value="error"/>
        </module>
        
        <!-- Pattern 2: Generic detection for custom types with common generic naming patterns -->
        <!-- Catches types with suffixes that commonly indicate generics (Filter, Handler, Processor, etc.) -->
        <!-- This helps catch custom generic types and future additions without hardcoding each one -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="AvoidRawTypesCustom"/>
            <property name="format" value="(?&lt;!import\s)(?&lt;!import static\s)(?&lt;!new\s)(?&lt;!class\s)(?&lt;!interface\s)(?&lt;!extends\s)(?&lt;!implements\s)(?&lt;!&lt;)\b([A-Z][a-zA-Z0-9]*(?:Filter|Handler|Processor|Provider|Factory|Builder|Manager|Service|Repository|Controller|Adapter|Converter|Transformer|Validator|Parser|Reader|Writer|Listener|Observer|Strategy|Template|Wrapper|Container))\s+[a-z][a-zA-Z0-9]*(?=\s*[;=,)\]]|$)(?!.*\b\1\s*&lt;)"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Potential raw type usage detected. If this is a generic type, include type parameters (e.g., Filter&lt;T&gt; instead of Filter)."/>
            <property name="severity" value="warning"/>
        </module>

        <!-- Unused imports checking. -->
        <module name="UnusedImports">
            <property name="severity" value="error"/>
        </module>

        <!-- Detect fully qualified names used inline instead of imports -->
        <!-- Matches patterns like: java.util.List, com.example.MyClass, org.apache.Something -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="AvoidFullyQualifiedNames"/>
            <property name="format" value="[^/\*\s]+(java|javax|org|com|net|io)\.[a-z]+(\.[a-z][a-zA-Z0-9]*)+\.[A-Z][a-zA-Z0-9]*[^;]"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Avoid using fully qualified class names. Use imports instead."/>
            <property name="severity" value="warning"/>
        </module>

        <!-- Alternative: More aggressive check for any fully qualified names (2+ package segments + class) -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="AvoidFullyQualifiedNamesGeneral"/>
            <property name="format" value="(?&lt;!import\s)(?&lt;!import static\s)(?&lt;!package\s)[a-z][a-z0-9]*(\.[a-z][a-z0-9]*)+\.[A-Z][a-zA-Z0-9]*(?=\s*[&lt;(\s])"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Use import statements instead of fully qualified class names."/>
            <property name="severity" value="warning"/>
        </module>

        <!-- Left curly goes on end of line (eol). -->
        <module name="LeftCurly">
            <property name="option" value="eol"/>
            <property name="severity" value="error"/>
        </module>

        <!-- Right curly goes same line as 'else', 'try', and 'catch'. -->
        <module name="RightCurly">
            <property name="option" value="same"/>
            <property name="severity" value="error"/>
        </module>

        <!-- Need braces for all code blocks. -->
        <module name="NeedBraces">
            <property name="severity" value="error"/>
        </module>

        <!-- Checks that a token is surrounded by whitespace. -->
        <module name="WhitespaceAround">
            <property name="severity" value="error"/>
        </module>

        <!-- Checks that a token is followed by whitespace. -->
        <module name="WhitespaceAfter">
            <property name="severity" value="error"/>
        </module>

        <!-- Checks the policy on the padding of parentheses. -->
        <module name="ParenPad">
            <property name="severity" value="error"/>
        </module>

        <!-- Fails if there is whitespace around generic '<' '>' characters. -->
        <module name="GenericWhitespace">
            <property name="severity" value="error"/>
        </module>

        <!-- Cyclomatic complexity limit of 7. -->
        <module name="CyclomaticComplexity">
            <property name="max" value="7"/>
            <property name="severity" value="warning"/>
        </module>

        <!-- Checks that long constants are defined with an upper ell. 'l' looks too much like '1'. -->
        <module name="UpperEll">
            <property name="severity" value="error"/>
        </module>

        <!-- Enforce Java array type style. -->
        <module name="ArrayTypeStyle">
            <property name="severity" value="error"/>
        </module>

        <!-- Not enforcing Javadoc checkstyle ... for now -->
        <!-- Simple Javadoc style check. -->
        <module name="JavadocStyle">
            <property name="severity" value="ignore"/>
        </module>

        <!-- Checks Javadoc comments for class and interface definitions. -->
        <module name="JavadocType">
            <property name="scope" value="protected"/>
            <property name="severity" value="ignore"/>
        </module>

        <!-- Checks the Javadoc of a method or constructor. -->
        <module name="JavadocMethod">
            <!-- <property name="scope" value="protected"/>-->
            <!-- <property name="allowThrowsTagsForSubclasses" value="true"/>-->
            <!-- <property name="allowUndeclaredRTE" value="true"/>-->
            <property name="severity" value="ignore"/>
            <!-- <property name="accessModifiers" value="package, private, public, protected"/>-->
            <property name="allowMissingParamTags" value="false"/>
            <!-- <property name="tokens" value="CTOR_DEF, ANNOTATION_FIELD_DEF, METHOD_DEF, COMPACT_CTOR_DEF"/>-->
            <property name="tokens" value="CTOR_DEF, ANNOTATION_FIELD_DEF, METHOD_DEF"/>
            <property name="validateThrows" value="true"/>
        </module>

        <!-- Checks that variables have Javadoc comments. -->
        <module name="JavadocVariable">
            <property name="scope" value="protected"/>
            <property name="severity" value="ignore"/>
        </module>

    </module>

    <!-- Checks if a line it too long. -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="severity" value="ignore"/>
    </module>

</module>
